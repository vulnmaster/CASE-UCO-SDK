    {"id": "process", "kind": "process", "tool": "process_document_file", "optional": true},
    {"id": "build", "kind": "build", "tool": "build_investigation", "args": {"profile_id": "HashIntelligence"}},
    {"id": "validate", "kind": "validate", "tool": "validate_graph", "args": {"extensions": ["cac"]}},
    {"id": "critic", "kind": "critic", "tool": "start_critic_review"}
