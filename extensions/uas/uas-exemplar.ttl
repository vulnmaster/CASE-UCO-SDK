	a uco-observable:GeoLocationEntry ;
	uco-core:name "GNSS fix nearest the climb peak, 2026-07-04T11:51:30.180Z" ;
	uco-core:hasFacet <urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1ca1> .

<urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1ca1>
	a uco-observable:GeoLocationEntryFacet ;
	uco-observable:location <urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1cb0> ;
	proposed-obs:observationTime "2026-07-04T11:51:30.180Z"^^xsd:dateTime .

<urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1cb0>
	a uco-location:Location ;
	uco-core:name "Position at the GNSS fix nearest the climb peak" ;
	uco-core:hasFacet
		<urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1cb1> ,
		<urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1cb2> .

<urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1cb1>
	a uco-location:LatLongCoordinatesFacet ;
	uco-location:latitude "51.7620366"^^xsd:decimal ;
	uco-location:longitude "-1.2565564"^^xsd:decimal ;
	uco-location:altitude "20.09"^^xsd:decimal ;
	proposed-loc:altitudeReference "mean sea level" ;
	proposed-loc:horizontalAccuracy "0.3"^^xsd:decimal ;
	proposed-loc:verticalAccuracy "0.3"^^xsd:decimal .

<urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1cb2>
	a uco-location:GPSCoordinatesFacet ;
	uco-core:description "Precision and accuracy as the receiver reported them: HDop from the GPS record, VDop/HAcc/VAcc from the paired GPA record. The metric accuracies have no home in UCO today, which is why they are carried on the proposed terms." ;
	uco-location:hdop "1.21"^^xsd:decimal ;
	uco-location:vdop "2.0"^^xsd:decimal ;
	proposed-loc:satelliteCount "10"^^xsd:nonNegativeInteger ;
	proposed-loc:fixQuality "simulated" .

# --- The mode change under investigation ----------------------------------

<urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1cc0>
	a uas:FlightModeChange ;
	uco-core:name "Mode change to RTL at 2026-07-04T11:51:43.627Z" ;
	uco-core:description "MODE record: ModeNum 6 (RTL), Rsn 2 (GCS_COMMAND), 2.452 s after a STATUSTEXT from system 141 / component 190. ArduPilot logs the reason but not the commanding system id, so uas:commandedBy records the only candidate the log identifies and the description states the limit of that inference." ;
	uco-core:startTime "2026-07-04T11:51:43.627Z"^^xsd:dateTime ;
	uas:flightMode "RTL" ;
	uas:previousFlightMode "GUIDED" ;
	uas:flightModeChangeReason "GCS_COMMAND" ;
	uas:autopilotFamily "ArduPilot" ;
	uas:commandedBy <urn:uuid:6f1b4c02-6a1e-5c48-9f3a-0d2b7e5a1c50> .
