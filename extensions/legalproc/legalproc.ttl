# Legal Process and Procedure Extension (T-Box)
#
# Local implementation of the criminal legal process stub concepts proposed
# upstream to CASE, so SDK graphs can model charges, pleas, proceedings,
# verdicts, sentences, forfeiture, and restitution for ANY investigation
# type (violent crime, financial crime, CAC, terrorism, ...) while the
# proposals are pending. When CASE adopts the namespaces, these terms
# re-parent (rdfs:subPropertyOf / rdfs:subClassOf) to the CASE terms and
# this extension shrinks to a bridge file.
#
# Upstream proposals tracked:
#   - https://github.com/casework/CASE/issues/192  (criminal process stubs)
#   - https://github.com/casework/CASE/issues/193  (civil process stubs)
#   - https://github.com/casework/CASE/issues/194  (corporate process stubs)
#   - https://github.com/casework/CASE/issues/191  (caseIdentifier + InvestigationRelationship)
#
# Validated against: U.S. v. Perry & O'Dell, No. 2:22-cr-04065-BCW (W.D. Mo.)
# — a 45-count conspiracy / attempted murder / firearms prosecution.

@prefix legalproc: <https://ontology.caseontology.org/case/criminal/> .
@prefix uco-core: <https://ontology.unifiedcyberontology.org/uco/core/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://ontology.caseontology.org/case/criminal>
	a owl:Ontology ;
	rdfs:label "Legal Process and Procedure Extension"@en ;
	rdfs:comment "Jurisdiction-neutral criminal legal process concepts (charges, charging instruments, pleas, proceedings, verdicts, sentences, forfeiture, restitution, and criminal discovery/disclosure obligations) implementing the stub namespaces proposed to CASE in issues 192-194, usable by any investigation domain until CASE adopts them upstream."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

#################################################################
# Classes
#################################################################

legalproc:CriminalCharge
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "CriminalCharge"@en ;
	rdfs:comment "A criminal charge is a formal accusation, stated as one or more counts within a charging instrument, that a person committed a specific statutory offense. Inchoate and derivative offenses (conspiracy, attempt, solicitation, aiding and abetting, and predicate-linked offenses such as 18 U.S.C. § 924(c) firearm counts) are criminal charges whose offenseForm and objectOffense properties record the form and the object or predicate offense. See Federal Rule of Criminal Procedure 7 (https://www.law.cornell.edu/rules/frcrmp/rule_7)."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:ChargingInstrument
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "ChargingInstrument"@en ;
	rdfs:comment "A charging instrument is a formal document that initiates or amends criminal charges against one or more defendants, such as a criminal complaint, indictment, superseding indictment, or information. See Federal Rule of Criminal Procedure 7 (https://www.law.cornell.edu/rules/frcrmp/rule_7)."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:Plea
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "Plea"@en ;
	rdfs:comment "A plea is a defendant's formal answer to a criminal charge. See Federal Rule of Criminal Procedure 11 (https://www.law.cornell.edu/rules/frcrmp/rule_11)."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:CriminalProceeding
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "CriminalProceeding"@en ;
	rdfs:comment "A criminal proceeding is a formal event in a criminal case conducted before a tribunal, such as an arraignment, detention hearing, trial, plea hearing, sentencing hearing, or appeal."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:Verdict
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "Verdict"@en ;
	rdfs:comment "A verdict is a finder of fact's formal determination on a criminal charge, such as a jury's finding of guilty or not guilty on a count. See Federal Rule of Criminal Procedure 31 (https://www.law.cornell.edu/rules/frcrmp/rule_31)."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:Sentence
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "Sentence"@en ;
	rdfs:comment "A sentence is a penalty recommended by a party or imposed by a tribunal upon conviction of a criminal charge. Use sentenceKind to record the kind of imposed or recommended sentence (custodial term, supervised release, probation, community service, or a fine imposed as part of the sentence). Do not use this class for bail, bond, pretrial detention conditions, restitution, forfeiture, special assessments, statutory maxima, guideline ranges, or other potential penalties; those facts use PretrialReleaseCondition, RestitutionOrder, ForfeitureOrder, or PotentialPenalty. See 18 U.S.C. § 3553 (https://www.law.cornell.edu/uscode/text/18/3553)."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:ForfeitureOrder
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "ForfeitureOrder"@en ;
	rdfs:comment "A forfeiture order is an order, or pre-conviction allegation, requiring surrender to the state of property involved in or traceable to an offense. See 18 U.S.C. §§ 981-982 (https://www.law.cornell.edu/uscode/text/18/981)."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:RestitutionOrder
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "RestitutionOrder"@en ;
	rdfs:comment "A restitution order is an order or request that an offender compensate victims for losses caused by the offense, monetarily or in kind. See 18 U.S.C. § 3663A (https://www.law.cornell.edu/uscode/text/18/3663A)."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:PleaAgreement
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "PleaAgreement"@en ;
	rdfs:comment "A plea agreement is a negotiated agreement between the prosecution and a defendant concerning the plea that will be entered and any agreed dispositions or sentencing recommendations, as recognized by Federal Rule of Criminal Procedure 11(c) (https://www.law.cornell.edu/rules/frcrmp/rule_11). The plea itself remains a separate Plea resource linked by recordsPlea. This class is the jurisdiction-neutral plea-agreement concept for CASE/UCO graphs; do not use domain-specific homonyms such as cryptoinv:PleaAgreement."@en ;
	dcterms:source "https://www.law.cornell.edu/rules/frcrmp/rule_11"^^xsd:anyURI .

legalproc:PotentialPenalty
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "PotentialPenalty"@en ;
	rdfs:comment "A potential penalty is a statutory maximum, mandatory minimum, or advisory guideline range that a source reports as possible exposure, not as a sentence that a tribunal has imposed. See 18 U.S.C. § 3559 (https://www.law.cornell.edu/uscode/text/18/3559) and the U.S. Sentencing Guidelines (https://www.ussc.gov/guidelines). Never type a potential penalty as Sentence."@en ;
	dcterms:source "https://www.law.cornell.edu/uscode/text/18/3559"^^xsd:anyURI .

legalproc:PretrialReleaseCondition
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "PretrialReleaseCondition"@en ;
	rdfs:comment "A pretrial release condition is a bail, bond, personal-recognizance, or detention-without-bond condition that governs liberty before conviction. See 18 U.S.C. § 3142 (https://www.law.cornell.edu/uscode/text/18/3142). Never type bail or bond as an imposed Sentence."@en ;
	dcterms:source "https://www.law.cornell.edu/uscode/text/18/3142"^^xsd:anyURI .

legalproc:StateCharge
	a owl:Class ;
	rdfs:subClassOf legalproc:CriminalCharge ;
	rdfs:label "StateCharge"@en ;
	rdfs:comment "A criminal charge under the law of a constituent state, province, or equivalent subnational jurisdiction, used when the source establishes that the charge is not federal. Pair with a StateJurisdiction (or equivalent) node via a registered uco-core:Relationship when a jurisdiction node is available. Keep state-specific charge subclasses outside this extension."@en ;
	dcterms:source "https://www.law.cornell.edu/wex/jurisdiction"^^xsd:anyURI .

legalproc:FederalCharge
	a owl:Class ;
	rdfs:subClassOf legalproc:CriminalCharge ;
	rdfs:label "FederalCharge"@en ;
	rdfs:comment "A criminal charge under federal or national law, used when the source establishes federal jurisdiction. Pair with a FederalJurisdiction (or equivalent) node via a registered uco-core:Relationship when a jurisdiction node is available."@en ;
	dcterms:source "https://www.law.cornell.edu/wex/federal_jurisdiction"^^xsd:anyURI .

legalproc:StateJurisdiction
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "StateJurisdiction"@en ;
	rdfs:comment "A state, provincial, or equivalent subnational criminal jurisdiction. Link charges and proceedings to this node with a registered uco-core:Relationship until a direct ontology property is adopted. Compatible with the CAC multi-jurisdiction class of the same local name when both extensions are loaded."@en ;
	dcterms:source "https://www.law.cornell.edu/wex/jurisdiction"^^xsd:anyURI .

legalproc:FederalJurisdiction
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "FederalJurisdiction"@en ;
	rdfs:comment "A federal or national criminal jurisdiction. Link charges and proceedings to this node with a registered uco-core:Relationship until a direct ontology property is adopted. Compatible with the CAC multi-jurisdiction class of the same local name when both extensions are loaded."@en ;
	dcterms:source "https://www.law.cornell.edu/wex/federal_jurisdiction"^^xsd:anyURI .

legalproc:DisclosureObligation
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "DisclosureObligation"@en ;
	rdfs:comment "A prosecutor's sourced duty to disclose specified information or evidence to the defense. Use disclosureKind to record the governing doctrine (Brady, Giglio, Jencks, or Federal Rule of Criminal Procedure 16) and disclosureStatus for the current production state. Do not infer an obligation from the mere existence of exam notes or statements. See Brady v. Maryland, 373 U.S. 83 (1963) (https://supreme.justia.com/cases/federal/us/373/83/), Giglio v. United States, 405 U.S. 150 (1972) (https://supreme.justia.com/cases/federal/us/405/150/), the Jencks Act, 18 U.S.C. § 3500 (https://www.law.cornell.edu/uscode/text/18/3500), and Federal Rule of Criminal Procedure 16 (https://www.law.cornell.edu/rules/frcrmp/rule_16)."@en ;
	dcterms:source "https://www.law.cornell.edu/rules/frcrmp/rule_16"^^xsd:anyURI .

legalproc:DiscoveryProduction
	a owl:Class ;
	rdfs:subClassOf uco-core:UcoObject ;
	rdfs:label "DiscoveryProduction"@en ;
	rdfs:comment "A sourced act of producing discovery material to the defense in satisfaction of a DisclosureObligation. See Federal Rule of Criminal Procedure 16 (https://www.law.cornell.edu/rules/frcrmp/rule_16)."@en ;
	dcterms:source "https://www.law.cornell.edu/rules/frcrmp/rule_16"^^xsd:anyURI .

legalproc:SuppressionMotion
	a owl:Class ;
	rdfs:subClassOf legalproc:CriminalProceeding ;
	rdfs:label "SuppressionMotion"@en ;
	rdfs:comment "A defense motion to exclude evidence, typically under the Fourth Amendment or Federal Rule of Criminal Procedure 12. Model only when a docket or filing establishes the motion. See Federal Rule of Criminal Procedure 12 (https://www.law.cornell.edu/rules/frcrmp/rule_12)."@en ;
	dcterms:source "https://www.law.cornell.edu/rules/frcrmp/rule_12"^^xsd:anyURI .

#################################################################
# Datatype properties
#################################################################

legalproc:caseIdentifier
	a owl:DatatypeProperty ;
	rdfs:subPropertyOf uco-core:externalIdentifier ;
	rdfs:label "caseIdentifier"@en ;
	skos:altLabel "case number"@en ;
	rdfs:comment "An identifier assigned to an investigation or prosecution by the organization or case-management authority conducting or tracking it, e.g. a court docket number such as '2:22-cr-04065-BCW' (see PACER, https://pacer.uscourts.gov/). Tracks the investigation:caseIdentifier property proposed in CASE issue 191."@en ;
	dcterms:source "https://github.com/casework/CASE/issues/191"^^xsd:anyURI ;
	rdfs:range xsd:string .

legalproc:statuteCitation
	a owl:DatatypeProperty ;
	rdfs:label "statuteCitation"@en ;
	rdfs:comment "Citation of the charged offense in the governing jurisdiction, e.g. '18 U.S.C. §§ 1117 & 1114'."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range xsd:string .

legalproc:countNumber
	a owl:DatatypeProperty ;
	rdfs:label "countNumber"@en ;
	rdfs:comment "Ordinal count number of the charge within its charging instrument. A charge asserted in a range of counts (e.g. Counts 4-10) may carry multiple values."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range xsd:nonNegativeInteger .

legalproc:countLabel
	a owl:DatatypeProperty ;
	rdfs:label "countLabel"@en ;
	rdfs:comment "The count designation as printed in the charging instrument, e.g. 'Count 1', 'Counts 4-10', 'Count 1sss' (PACER superseding-indictment notation)."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range xsd:string .

legalproc:offenseForm
	a owl:DatatypeProperty ;
	rdfs:label "offenseForm"@en ;
	rdfs:comment "The form of the charged offense, as an open vocabulary. Recommended values: 'substantive' (completed offense), 'conspiracy' (agreement to commit an object offense, e.g. 18 U.S.C. §§ 371, 1117), 'attempt' (e.g. 18 U.S.C. § 1113), 'solicitation', 'aiding-abetting' (e.g. 18 U.S.C. § 2), 'derivative' (offense defined by reference to a predicate offense, e.g. 18 U.S.C. § 924(c) use of a firearm in furtherance of a crime of violence). Use objectOffense to link a non-substantive charge to its object or predicate charge."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range xsd:string .

legalproc:chargeClassification
	a owl:DatatypeProperty ;
	rdfs:label "chargeClassification"@en ;
	rdfs:comment "The offense classification in the governing jurisdiction, e.g. 'Class A Felony' per 18 U.S.C. § 3559 (https://www.law.cornell.edu/uscode/text/18/3559)."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range xsd:string .

legalproc:chargeDisposition
	a owl:DatatypeProperty ;
	rdfs:label "chargeDisposition"@en ;
	rdfs:comment "The current disposition of the charge, as an open vocabulary. Recommended values: 'pending', 'dismissed', 'acquitted', 'convicted-by-verdict', 'convicted-by-plea', 'merged'."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range xsd:string .

legalproc:instrumentType
	a owl:DatatypeProperty ;
	rdfs:label "instrumentType"@en ;
	rdfs:comment "The type of charging instrument, as an open vocabulary. Recommended values: 'complaint', 'indictment', 'superseding-indictment', 'information'."@en ;
	rdfs:domain legalproc:ChargingInstrument ;
	rdfs:range xsd:string .

legalproc:pleaType
	a owl:DatatypeProperty ;
	rdfs:label "pleaType"@en ;
	rdfs:comment "The type of plea entered, as an open vocabulary. Recommended values: 'guilty', 'not-guilty', 'nolo-contendere'."@en ;
	rdfs:domain legalproc:Plea ;
	rdfs:range xsd:string .

legalproc:proceedingType
	a owl:DatatypeProperty ;
	rdfs:label "proceedingType"@en ;
	rdfs:comment "The type of criminal proceeding, as an open vocabulary. Recommended values: 'arraignment', 'detention-hearing', 'preliminary-hearing', 'trial', 'plea-hearing', 'sentencing-hearing', 'appeal'."@en ;
	rdfs:domain legalproc:CriminalProceeding ;
	rdfs:range xsd:string .

legalproc:verdictType
	a owl:DatatypeProperty ;
	rdfs:label "verdictType"@en ;
	rdfs:comment "The determination recorded by the verdict, as an open vocabulary. Recommended values: 'guilty', 'not-guilty'."@en ;
	rdfs:domain legalproc:Verdict ;
	rdfs:range xsd:string .

legalproc:sentenceStatus
	a owl:DatatypeProperty ;
	rdfs:label "sentenceStatus"@en ;
	rdfs:comment "Whether the sentence is a party recommendation, an imposed judgment, or has been vacated, as an open vocabulary. Recommended values: 'recommended', 'imposed', 'vacated'."@en ;
	rdfs:domain legalproc:Sentence ;
	rdfs:range xsd:string .

legalproc:sentenceTerm
	a owl:DatatypeProperty ;
	rdfs:label "sentenceTerm"@en ;
	rdfs:comment "The custodial term as stated in the record, kept verbatim to avoid fabricating precision, e.g. 'Life', '165 years', '25 years concurrent + 140 years consecutive'."@en ;
	rdfs:domain legalproc:Sentence ;
	rdfs:range xsd:string .

legalproc:sentenceKind
	a owl:DatatypeProperty ;
	rdfs:label "sentenceKind"@en ;
	rdfs:comment "The kind of sentence when the resource is a Sentence. Closed vocabulary: 'custodial', 'supervised-release', 'probation', 'community-service', 'fine-as-sentence'. Values such as 'bail', 'bond', 'statutory-maximum', 'potential-penalty', 'restitution', 'forfeiture', and 'special-assessment' are invalid on Sentence; use PretrialReleaseCondition, PotentialPenalty, RestitutionOrder, or ForfeitureOrder instead."@en ;
	rdfs:domain legalproc:Sentence ;
	rdfs:range xsd:string .

legalproc:outcomeScope
	a owl:DatatypeProperty ;
	rdfs:label "outcomeScope"@en ;
	rdfs:comment "Whether a charge, plea, verdict, sentence, conviction, or potential penalty belongs to the current matter or to prior-conviction history mentioned by the source. Closed vocabulary: 'current-case', 'prior-history'. Required for independently queryable current versus prior outcomes. See Federal Rule of Evidence 404(b) (https://www.law.cornell.edu/rules/fre/rule_404) for the prior-act distinction this property encodes."@en ;
	rdfs:range xsd:string .

legalproc:jurisdictionKind
	a owl:DatatypeProperty ;
	rdfs:label "jurisdictionKind"@en ;
	rdfs:comment "Whether a charge or proceeding is state, federal, or unknown from the source. Closed vocabulary: 'state', 'federal', 'unknown'. Use 'unknown' only when the source does not establish jurisdiction; do not infer jurisdiction from a URL host or agency label."@en ;
	rdfs:range xsd:string .

legalproc:victimFactStatus
	a owl:DatatypeProperty ;
	rdfs:label "victimFactStatus"@en ;
	rdfs:comment "Whether the source reported victim identity, location, age, or count. Closed vocabulary: 'reported', 'omitted'. When the value is 'omitted', do not add victim identity nodes or a zero/negative count; omission is not a finding of zero. See the Crime Victims' Rights Act, 18 U.S.C. § 3771 (https://www.law.cornell.edu/uscode/text/18/3771)."@en ;
	rdfs:range xsd:string .

legalproc:reportedVictimCount
	a owl:DatatypeProperty ;
	rdfs:label "reportedVictimCount"@en ;
	rdfs:comment "The victim count only when the source states a number. Must not be used when victimFactStatus is 'omitted'."@en ;
	rdfs:range xsd:nonNegativeInteger .

legalproc:potentialPenaltyKind
	a owl:DatatypeProperty ;
	rdfs:label "potentialPenaltyKind"@en ;
	rdfs:comment "The kind of potential penalty. Closed vocabulary: 'statutory-maximum', 'mandatory-minimum', 'guideline-range'."@en ;
	rdfs:domain legalproc:PotentialPenalty ;
	rdfs:range xsd:string .

legalproc:releaseConditionKind
	a owl:DatatypeProperty ;
	rdfs:label "releaseConditionKind"@en ;
	rdfs:comment "The kind of pretrial release or detention condition. Closed vocabulary: 'bail', 'bond', 'personal-recognizance', 'detained-without-bond'."@en ;
	rdfs:domain legalproc:PretrialReleaseCondition ;
	rdfs:range xsd:string .

legalproc:sourcePublicationTime
	a owl:DatatypeProperty ;
	rdfs:label "sourcePublicationTime"@en ;
	rdfs:comment "The time the source artifact (press release, docket entry, or other public record) was published or issued, as stated by that source. Distinct from sourceRetrievalTime and from uco-core:objectCreatedTime, which records when the graph characterization was created."@en ;
	rdfs:range xsd:dateTime .

legalproc:sourceRetrievalTime
	a owl:DatatypeProperty ;
	rdfs:label "sourceRetrievalTime"@en ;
	rdfs:comment "The time an investigator or tool retrieved the source artifact. Distinct from sourcePublicationTime and from uco-core:objectCreatedTime / uco-core:modifiedTime on the graph objects."@en ;
	rdfs:range xsd:dateTime .

legalproc:monetaryAmount
	a owl:DatatypeProperty ;
	rdfs:label "monetaryAmount"@en ;
	rdfs:comment "The monetary amount of a restitution or forfeiture obligation, in the currency identified by currencyCode."@en ;
	rdfs:range xsd:decimal .

legalproc:currencyCode
	a owl:DatatypeProperty ;
	rdfs:label "currencyCode"@en ;
	rdfs:comment "ISO 4217 currency code for a monetary amount, e.g. 'USD' (https://www.iso.org/iso-4217-currency-codes.html)."@en ;
	rdfs:range xsd:string .

#################################################################
# Object properties
#################################################################

legalproc:concernsCharge
	a owl:ObjectProperty ;
	rdfs:label "concernsCharge"@en ;
	rdfs:comment "Links a plea, proceeding, verdict, sentence, forfeiture order, or restitution order to the criminal charge(s) it concerns."@en ;
	rdfs:range legalproc:CriminalCharge ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:objectOffense
	a owl:ObjectProperty ;
	rdfs:label "objectOffense"@en ;
	rdfs:comment "Links an inchoate or derivative criminal charge (conspiracy, attempt, solicitation, aiding-abetting, predicate-linked offense) to the charge representing its object or predicate offense, e.g. a conspiracy-to-murder count to the murder offense conspired at, or an 18 U.S.C. § 924(c) firearm count to the crime-of-violence count it is charged in furtherance of."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range legalproc:CriminalCharge ;
	dcterms:source "https://github.com/casework/CASE/issues/192"^^xsd:anyURI .

legalproc:assertedIn
	a owl:ObjectProperty ;
	rdfs:label "assertedIn"@en ;
	rdfs:comment "Links a criminal charge to the charging instrument (complaint, indictment, superseding indictment, information) in which it is asserted."@en ;
	rdfs:domain legalproc:CriminalCharge ;
	rdfs:range legalproc:ChargingInstrument .

legalproc:recordsPlea
	a owl:ObjectProperty ;
	rdfs:label "recordsPlea"@en ;
	rdfs:comment "Links a plea agreement to the Plea resource that records the plea entered under that agreement. See Federal Rule of Criminal Procedure 11(c) (https://www.law.cornell.edu/rules/frcrmp/rule_11)."@en ;
	rdfs:domain legalproc:PleaAgreement ;
	rdfs:range legalproc:Plea .

legalproc:disclosureKind
	a owl:DatatypeProperty ;
	rdfs:label "disclosureKind"@en ;
	rdfs:comment "The doctrine that creates the disclosure obligation. Closed vocabulary: 'brady', 'giglio', 'jencks', 'rule-16', 'other'. See Brady v. Maryland, 373 U.S. 83 (1963); Giglio v. United States, 405 U.S. 150 (1972); 18 U.S.C. § 3500; Federal Rule of Criminal Procedure 16."@en ;
	rdfs:domain legalproc:DisclosureObligation ;
	rdfs:range xsd:string .

legalproc:disclosureStatus
	a owl:DatatypeProperty ;
	rdfs:label "disclosureStatus"@en ;
	rdfs:comment "Whether the obligated material has been reviewed or produced. Closed vocabulary: 'not-reviewed', 'disclosed', 'withheld-pending-review'. Do not use 'disclosed' unless a source records production."@en ;
	rdfs:domain legalproc:DisclosureObligation ;
	rdfs:range xsd:string .

legalproc:disclosureSourceCitation
	a owl:DatatypeProperty ;
	rdfs:label "disclosureSourceCitation"@en ;
	rdfs:comment "Citation of the filing, log, or prosecutor source that established the disclosure obligation or production (for example a discovery certificate or docket entry). Required; omission is not an invitation to infer Brady from unlabeled exam notes."@en ;
	rdfs:range xsd:string .

legalproc:concernsEvidence
	a owl:ObjectProperty ;
	rdfs:label "concernsEvidence"@en ;
	rdfs:comment "Links a disclosure obligation or discovery production to the evidence, statement, or report IRI it concerns. The target must be an IRI, not a blank node."@en ;
	rdfs:range uco-core:UcoObject .

legalproc:satisfiesObligation
	a owl:ObjectProperty ;
	rdfs:label "satisfiesObligation"@en ;
	rdfs:comment "Links a DiscoveryProduction to the DisclosureObligation it fulfills."@en ;
	rdfs:domain legalproc:DiscoveryProduction ;
	rdfs:range legalproc:DisclosureObligation .

legalproc:chargedWith
	a owl:ObjectProperty ;
	rdfs:label "chargedWith"@en ;
	rdfs:comment "Links a person or organization to a criminal charge asserted against them. Compatible with the CAC legal-outcomes property of the same local name when both extensions are loaded. See Federal Rule of Criminal Procedure 7 (https://www.law.cornell.edu/rules/frcrmp/rule_7)."@en ;
	rdfs:range legalproc:CriminalCharge ;
	dcterms:source "https://www.law.cornell.edu/rules/frcrmp/rule_7"^^xsd:anyURI .

legalproc:appliesTo
	a owl:ObjectProperty ;
	rdfs:label "appliesTo"@en ;
	rdfs:comment "Links an imposed or recommended sentence to the criminal charge or charges it applies to. Compatible with the CAC legal-outcomes property of the same local name when both extensions are loaded."@en ;
	rdfs:domain legalproc:Sentence ;
	rdfs:range legalproc:CriminalCharge .
