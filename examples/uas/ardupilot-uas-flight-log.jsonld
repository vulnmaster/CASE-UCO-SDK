    {
      "@id": "urn:uuid:b5a08638-2702-53c1-9bc6-d0e663e72837",
      "@type": "uas:Flight",
      "uco-core:name": "Flight of 2026-07-04, 11:50:49Z to 11:52:54Z",
      "uco-core:description": "Bounded by the 'Arming motors' and 'Disarming motors' MSG records; 125.091 s from arm to disarm. Maximum altitude 19.99 m above the home position (20.07 m AMSL) at 2026-07-04T11:51:30.240Z, from the POS record (EKF-fused position); RelHomeAlt is relative to the home position captured at arming. DataFlash records are stamped in TimeUS, microseconds since autopilot boot. Wall-clock times in this graph are derived by anchoring TimeUS 43419292 to the GNSS time in the first 3D-fix GPS record (week 2425, 561067200 ms of week), converted by GPS week/ms-of-week to UTC, minus 18 leap seconds. Any error in the leap-second constant shifts every derived time equally. This log is an ArduPilot SITL (software-in-the-loop) capture: the log records 'RC Protocol: SITL' and carries SIM/SIM2 simulator state records. Positions are simulator output, not observations of a physical aircraft.",
      "uco-core:startTime": {
        "@type": "xsd:dateTime",
        "@value": "2026-07-04T11:50:49.196Z"
