    {
      "@id": "urn:uuid:ac7f6223-2357-5303-b1d0-8a6b1ca7e5ba",
      "@type": "uco-observable:ObservableObject",
      "uco-core:name": "Unattributed MAVLink node, system 141 / component 190",
      "uco-core:description": "Observed only as the source address of a STATUSTEXT the autopilot logged at 2026-07-04T11:51:41.175Z as 'SRC=141/190:DFRWS26'. Component 190 is the Mission Planner ground-station component id, and system 141 is not the configured ground control station (255). MAVLink system ids are self-asserted; with sender authentication disabled on this aircraft the address is an observation about the link, not an identification of an operator.",
      "uco-core:hasFacet": [
        {
          "@id": "urn:uuid:3525efe8-930b-597d-8764-6b048cb9d15f",
          "@type": "uas:MavlinkEndpointFacet",
          "uas:mavlinkSystemId": {
            "@type": "xsd:nonNegativeInteger",
            "@value": "141"
          },
          "uas:mavlinkComponentId": {
            "@type": "xsd:nonNegativeInteger",
            "@value": "190"
          },
          "uas:mavlinkComponentName": "MAV_COMP_ID_MISSIONPLANNER",
          "uas:mavlinkDialect": "ardupilotmega v2.0"
        }
      ]
    },
    {
      "@id": "urn:uuid:1ff37f2a-84e3-5d72-919d-a9f61e23960a",
      "@type": "uco-observable:Message",
      "uco-core:name": "MAVLink STATUSTEXT 'DFRWS26'",
      "uco-core:description": "Received by the autopilot and written to the log verbatim. The text carries no command semantics; its evidential value is that it proves a node other than the configured ground control station was transmitting on the link, and when.",
      "uco-core:hasFacet": [
        {
          "@id": "urn:uuid:d70cc03a-6f92-57aa-9533-33167fcac58c",
