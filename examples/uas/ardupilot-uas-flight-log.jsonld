    {
      "@id": "urn:uuid:27850123-f992-5278-b15d-275fbbb9bfa0",
      "@type": "uco-observable:GeoLocationTrack",
      "uco-core:name": "Flight track from GNSS receiver fixes",
      "uco-core:description": "15 fixes sampled at roughly 10 s intervals from the log's 5 Hz GPS series, plus the fix nearest the climb peak. Entries are raw receiver fixes rather than the EKF-fused POS series, so each carries the satellite count and accuracy it was derived from. DataFlash records are stamped in TimeUS, microseconds since autopilot boot. Wall-clock times in this graph are derived by anchoring TimeUS 43419292 to the GNSS time in the first 3D-fix GPS record (week 2425, 561067200 ms of week), converted by GPS week/ms-of-week to UTC, minus 18 leap seconds. Any error in the leap-second constant shifts every derived time equally.",
      "uco-core:hasFacet": [
        {
          "@id": "urn:uuid:503609b1-07e0-501e-a1d8-90e504bc5d86",
