                            "Storage Detection Police Dogs" ;
    solveit-core:hasCASEOutputClass uco-observable:Device,
                                    uco-observable:location ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1005 ;
    solveit-core:hasReference :citationDFCite-1114 .

:techniqueDFT-1007
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1007: Detect the potential existence of digital devices using a SyncTriage-based approach"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1007" ;
    solveit-core:techniqueName "Detect the potential existence of digital devices using a SyncTriage-based approach" ;
    solveit-core:techniqueDescription "A technique developed in Hargreaves & Marshall (2018) whereby synchronization artifacts on a device are examined and used to identify the existence of a related device. Also sometimes used to infer activity that occurred on an inaccessible or unavailable device. " ;
    solveit-core:hasExample "SyncTriage - https://bitbucket.org/chrishargreaves/synctriage" ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1008,
                                      :weaknessDFW-1009,
                                      :weaknessDFW-1010,
                                      :weaknessDFW-1011,
                                      :weaknessDFW-1012 ;
    solveit-core:hasReference :citationDFCite-1057 .

