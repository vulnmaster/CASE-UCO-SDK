:techniqueDFT-1064
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1064: Carve non-allocated files"@en ;
    rdfs:subClassOf :techniqueDFT-1061 ;
    solveit-core:techniqueID "DFT-1064" ;
    solveit-core:techniqueName "Carve non-allocated files" ;
    solveit-core:techniqueDescription "The process of recovering files from non-allocated space using only the structural properties of files." ;
    solveit-core:techniqueDetails "File carving should result in not just the file content, but the offset in which it was found and the offset base (i.e. the disk, volume, or offset within another file). This approach uses internal files structural information only - if residual file system metadata is used then the complementary technique T1150 is more applicable." ;
    solveit-core:hasSynonym "file carving" ;
    solveit-core:hasExample "Photorec (Grenier 2023)",
                            "foremost",
                            "scalpel" ;
    solveit-core:hasCASEOutputClass uco-core:confidence,
                                    uco-observable:File,
                                    uco-observable:rangeOffset,
                                    uco-observable:rangeOffsetType ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1103,
                                      :weaknessDFW-1104,
                                      :weaknessDFW-1105,
                                      :weaknessDFW-1106,
                                      :weaknessDFW-1107 ;
    solveit-core:hasReference :citationDFCite-1011,
                              :citationDFCite-1048 .

:techniqueDFT-1065
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1065: Extract artifacts from operating system-level content indexer(s)"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1065" ;
    solveit-core:techniqueName "Extract artifacts from operating system-level content indexer(s)" ;
    solveit-core:techniqueDescription "Examine information from operating system artifacts relating to content indexing and search capabilities e.g. Windows Desktop Search" ;
    solveit-core:techniqueDetails "For example the Windows Search database '...contains vast amount of values about various of artifacts found on a Windows system, e.g. files and directories, emails, appointments, attachments, images, audio and video' (Metz 2011)" ;
    solveit-core:hasSynonym "OS search database examination",
                            "operating system search database examination" ;
    solveit-core:hasExample "Spotlight",
                            "Windows Search",
                            "Zeitgeist" ;
    solveit-core:hasCASEOutputClass uco-observable:fileName,
                                    uco-observable:filePath ;
    solveit-core:hasReference :citationDFCite-1100,
