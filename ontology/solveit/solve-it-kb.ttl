:techniqueDFT-1110
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1110: Preserve reference data"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1110" ;
    solveit-core:techniqueName "Preserve reference data" ;
    solveit-core:techniqueDetails "Reference data may be needed for later trace interpretation, but may change (especially server side software), so relevant data should be preserved close to the time of the event of interest" ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1172 ;
    solveit-core:hasReference :citationDFCite-1118 .

:techniqueDFT-1111
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1111: Record system clock offset"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1111" ;
    solveit-core:techniqueName "Record system clock offset" ;
    solveit-core:techniqueDescription "Recording a system clock compared with trusted time source" ;
    solveit-core:techniqueDetails "Collection of the time of a device clock compared with the correct time, allowing an offset to be calculated *for the point in time when the clock was observed*." ;
    solveit-core:hasCASEInputClass uco-observable:Device ;
    solveit-core:hasCASEOutputClass solveit-observable:ClockOffsetCapture,
                                    uco-observable:systemTime ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1173 .

:techniqueDFT-1112
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1112: Locate and remove physical disks from a device"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1112" ;
    solveit-core:techniqueName "Locate and remove physical disks from a device" ;
    solveit-core:techniqueDescription "Locate the physical storage media inside a device and remove it, so that it can be connected to an examination system for acquisition." ;
    solveit-core:techniqueDetails """This applies to devices such as desktop computers, laptops and servers where storage media is installed as a separate, detachable component. Examples include 2.5" and 3.5" SATA drives, M.2 SATA and NVMe SSDs, and mSATA drives.

The removed media is typically then connected via a hardware write blocker (DFT-1012), or connected directly (DFT-1166) with a software write blocker (DFT-1013).

Where storage is soldered to the motherboard, alternatives can be used e.g.,
- Accessing the storage in place via a bootable environment (DFT-1113).
- Removing the storage chip itself (DFT-1028).""" ;
    solveit-core:hasSynonym "Disk removal",
                            "Drive removal",
                            "Extract drive from device",
                            "Hard drive removal",
                            "Physical disk extraction",
                            "Remove SSD",
                            "Remove hard disk",
                            "Remove internal storage",
                            "Remove storage media",
                            "Storage media removal" ;
    solveit-core:hasCASEInputClass uco-observable:Computer ;
    solveit-core:hasCASEOutputClass uco-observable:StorageMedium ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1174,
                                      :weaknessDFW-1175,
                                      :weaknessDFW-1176 .

:techniqueDFT-1113
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1113: Access internal storage via bootable environment"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1113" ;
    solveit-core:techniqueName "Access internal storage via bootable environment" ;
    solveit-core:techniqueDescription "Booting the suspected computer device into an alternative operating system in order to image the attached disks." ;
    solveit-core:techniqueDetails "These operating systems are usually modified to contain forensic imaging tools and to avoid writing to the attached storage through the use of software write blocking (DFT-1013)" ;
    solveit-core:hasExample "PALADIN Forensic - is a modified “live” Linux distribution based on Ubuntu that simplifies various forensics tasks in a forensically sound manner via the PALADIN Toolbox.",
                            "WinFE - Windows Forensic Environment, is forensically sound, bootable Windows operation system that can be burned into USB and plug the USB into suspected device. Then, after changing boot order, booting to the USB to create forensic images from the tested Windows, MacOS and Linux systems." ;
    solveit-core:hasCASEInputClass uco-observable:Computer ;
    solveit-core:hasCASEOutputClass solveit-observable:ReadWriteDeviceInterface ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1177,
                                      :weaknessDFW-1178,
                                      :weaknessDFW-1179,
                                      :weaknessDFW-1180,
                                      :weaknessDFW-1182 ;
    solveit-core:hasReference :citationDFCite-1071,
                              :citationDFCite-1112,
                              :citationDFCite-1132 .

:techniqueDFT-1114
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1114: Preserve memory contents via Cold Boot Attack"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1114" ;
    solveit-core:techniqueName "Preserve memory contents via Cold Boot Attack" ;
    solveit-core:techniqueDescription "A precursor to extracting volatile memory (RAM) from a powered-off system by quickly rebooting or transferring the memory module to another system before residual data fades. Cooling the memory modules can significantly slow down data decay, preserving critical data such as encryption keys or passwords." ;
    solveit-core:techniqueDetails "An examiner freezes a computer’s RAM by spraying it with liquid nitrogen or even using inverted canned air, then powering off the live system without proper shutdown, and then booting into an external plugged USB, and try capturing the residual RAM content (DFT-1003) with encryption keys that might still be stored there" ;
    solveit-core:hasSynonym "Cold Boot Attack",
                            "Extracting RAM data using Cold Boot Attack" ;
    solveit-core:hasCASEOutputClass uco-observable:Memory ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1032 ;
    solveit-core:hasReference :citationDFCite-1053 .

:techniqueDFT-1115
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1115: Visualize geolocation information"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1115" ;
    solveit-core:techniqueName "Visualize geolocation information" ;
    solveit-core:techniqueDescription "Presenting points or paths visually using extracted data, typically on a map" ;
    solveit-core:hasExample "Autopsy Geolocation view (Basis Technology 2020)",
                            "Magnet Axiom 'World map view' (Magnet 2020)" ;
    solveit-core:hasCASEInputClass <https://ontology.unifiedcyberontology.org/uco/location/Location> ;
    solveit-core:hasReference :citationDFCite-1010,
                              :citationDFCite-1092,
                              :citationDFCite-1093 .

:techniqueDFT-1116
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1116: Extract references to connected devices"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1116" ;
    solveit-core:techniqueName "Extract references to connected devices" ;
    solveit-core:techniqueDescription "Examine artifacts and extract indicators of devices that have been connected to the target device." ;
    solveit-core:techniqueDetails "This technique extracts references to other devices that have potentially been connected to the device being examined. The subsequent interpretation of these artifacts (using T1088: Relational-based event reconstruction), could result in HypothesisedDevices. The separate process for inferring the connected device(s) captures the uncertainty in such an interpretation." ;
    solveit-core:hasExample "ADB connected hosts",
                            "Paired bluetooth devices",
                            "Synronization artifacts referencing another device",
                            "USB connected devices",
                            "iOS backups from a computer" ;
    solveit-core:hasCASEInputClass solveit-observable:FileSet ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1011,
                                      :weaknessDFW-1183,
                                      :weaknessDFW-1184 ;
    solveit-core:hasReference :citationDFCite-1001,
                              :citationDFCite-1057 .

:techniqueDFT-1117
