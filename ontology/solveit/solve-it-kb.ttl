    solveit-core:hasCASEOutputClass uco-observable:IPAddress,
                                    uco-observable:MACAddress,
                                    uco-observable:NetworkConnection,
                                    uco-observable:Process,
                                    uco-observable:UserAccount ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1034,
                                      :weaknessDFW-1035,
                                      :weaknessDFW-1036 ;
    solveit-core:hasReference :citationDFCite-1080,
                              :citationDFCite-1129 .

