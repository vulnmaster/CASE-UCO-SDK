:techniqueDFT-1042
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1042: Verify hash of copied data matches the hash of the data read from source device"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1042" ;
    solveit-core:techniqueName "Verify hash of copied data matches the hash of the data read from source device" ;
    solveit-core:techniqueDescription """Compares a hash of data read from a source device with a hash computed by reading back the copy of that data stored in a raw image or a forensic image container. 

The source hash may be computed as the data is read during imaging, or by reading the source device again at a later point. 

What distinguishes this technique is that the reference hash comes from reading the source device, rather than from a stored record of that hash. Comparison against a stored hash, whether inside the image file, in a separate file, or held externally, is covered by DFT-1204.""" ;
    solveit-core:hasCASEInputClass uco-observable:hash ;
    solveit-core:hasCASEOutputClass solveit-observable:HashVerificationResult ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1124,
                                      :weaknessDFW-1125,
                                      :weaknessDFW-1126 ;
    solveit-core:hasReference :citationDFCite-1081,
                              :citationDFCite-1083,
                              :citationDFCite-1088 .

:techniqueDFT-1043
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1043: Read bitstream from forensic image container file(s)"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1043" ;
    solveit-core:techniqueName "Read bitstream from forensic image container file(s)" ;
    solveit-core:techniqueDescription "The decoding of a forensic format such as EWF such that the raw sectors can be accessed by a forensic tool (typically performed on-the-fly internally in a tool.)" ;
    solveit-core:techniqueDetails "For example a EWF (Expert Witness Format) needs to be processed to expose the equivalent RAW image sectors." ;
    solveit-core:hasSynonym "Access forensic image content",
                            "Access forensic image",
                            "Decode forensic image bitstream",
                            "Read forensic format",
                            "Read forensic image" ;
    solveit-core:hasExample "Advanced Forensic Format (AFF)",
                            "Expert Witness Format (EWF)" ;
    solveit-core:hasCASEInputClass solveit-observable:PhysicalImageContainer ;
    solveit-core:hasCASEOutputClass solveit-observable:BitstreamRandomAccessed ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1121,
                                      :weaknessDFW-1122,
                                      :weaknessDFW-1259 .

