:techniqueDFT-1012
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1012: Write protect storage media using a hardware write blocker"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1012" ;
    solveit-core:techniqueName "Write protect storage media using a hardware write blocker" ;
    solveit-core:techniqueDescription "A hardware write blocking device [should] prevent any change to data in the user area of a hard drive while allowing access to all data on a hard drive. (Lyle 2006)" ;
    solveit-core:techniqueDetails "Note that \"Sometimes it may be desirable to change a drive configuration to obtain access to otherwise hidden sectors, for example, such as within an HPA (host protected area).\" (Lyle 2006) " ;
    solveit-core:hasCASEInputClass uco-observable:StorageMedium ;
    solveit-core:hasCASEOutputClass solveit-observable:WriteProtectedDeviceInterface ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1118,
                                      :weaknessDFW-1119,
                                      :weaknessDFW-1120 ;
    solveit-core:hasReference :citationDFCite-1089 .

:techniqueDFT-1013
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1013: Write protect storage media using a software write blocker"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1013" ;
    solveit-core:techniqueName "Write protect storage media using a software write blocker" ;
    solveit-core:techniqueDescription "Use of a software-based tool that prevents a computer from writing to computer storage media connected to it (NIST 2006)" ;
    solveit-core:techniqueDetails "Note that both read/write and write protected interfaces are specified as input since a software write blocker could be applied to a hardware write protected interface." ;
    solveit-core:hasCASEInputClass solveit-observable:ReadWriteDeviceInterface,
                                   solveit-observable:WriteProtectedDeviceInterface ;
    solveit-core:hasCASEOutputClass solveit-observable:WriteProtectedDeviceInterface ;
    solveit-core:hasReference :citationDFCite-1102 .

:techniqueDFT-1014
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1014: Document the chain of custody"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1014" ;
    solveit-core:techniqueName "Document the chain of custody" ;
    solveit-core:techniqueDescription "A process that tracks the movement of evidence through its collection, safeguarding, and analysis lifecycle by documenting each person who handled the evidence, the date/time it was collected or transferred, and the purpose for the transfer [DFCite-1147]." ;
    solveit-core:hasSynonym "CoC",
                            "Continuity of evidence" ;
    solveit-core:hasCASEInputClass case-investigation:ProvenanceRecord ;
    solveit-core:hasCASEOutputClass case-investigation:ProvenanceRecord ;
    solveit-core:hasReference :citationDFCite-1147 .

:techniqueDFT-1015
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1015: Collect logical files selectively based on privacy preserving criteria"@en ;
    rdfs:subClassOf :techniqueDFT-1004 ;
    solveit-core:techniqueID "DFT-1015" ;
    solveit-core:techniqueName "Collect logical files selectively based on privacy preserving criteria" ;
    solveit-core:techniqueDescription "Previewing a data source and selecting a subset of the data for collection into a container such as a tar/zip file or a forensic image format for the purposes of protecting the privacy of the complainant or witness." ;
    solveit-core:hasExample "Cellebrite - Allows filtering by app, data category, and/or by timestamp as to what data is collected.",
                            "Odyssey - Allows selective storing of data from mobile devices - https://www.bluelightsdigital.com/odyssey",
                            "XRY - Allows filtering by app, data category, and/or by timestamp as to what data is collected." ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1025,
                                      :weaknessDFW-1026,
                                      :weaknessDFW-1027,
                                      :weaknessDFW-1028 .

:techniqueDFT-1016
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1016: Collect specific pieces of information from a live running device"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1016" ;
    solveit-core:techniqueName "Collect specific pieces of information from a live running device" ;
    solveit-core:techniqueDescription "Running commands on a live system to collect specific pieces of information e.g. running processes or open ports" ;
    solveit-core:techniqueDetails """Prior to collecting data from the system, pre-stages are described in (Waits et al 2008) as:
- Establish trusted command shell
- Establish method for transmitting and storing the information
""" ;
    solveit-core:hasSynonym "Live response data collection",
                            "Volatile data collection" ;
    solveit-core:hasExample "ipconfig",
                            "netstat",
                            "procdump",
                            "pslist",
                            "psloggedon" ;
