:techniqueDFT-1020
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1020: Extract the file system from a mobile device"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1020" ;
    solveit-core:techniqueName "Extract the file system from a mobile device" ;
    solveit-core:techniqueDescription "Accessing the file system(s) of the device and extracting a set of files (full or partial depending on level of access)" ;
    solveit-core:techniqueDetails "Note that Fukami et al (2021) states \"In order to conduct effective file system extraction, rooting the device is required.\" See T1040. Usually results in a zip/tar file. Rooting may provide access to the file system, but files may still be encrypted. Attacking the user pin, usually on device, using T1034, or T1035 may be necessary, unless the PIN can be obtained from the device user (T1037)" ;
    solveit-core:hasSynonym "file system extraction" ;
    solveit-core:hasCASEInputClass uco-observable:MobileDevice ;
    solveit-core:hasCASEOutputClass solveit-observable:FileSystemExtraction ;
    solveit-core:hasPotentialWeakness :weaknessDFW-1159,
                                      :weaknessDFW-1160,
                                      :weaknessDFW-1161,
                                      :weaknessDFW-1162,
                                      :weaknessDFW-1163,
                                      :weaknessDFW-1164 ;
    solveit-core:hasReference :citationDFCite-1031,
                              :citationDFCite-1045,
                              :citationDFCite-1091 .

:techniqueDFT-1021
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1021: Extract artifacts from a configuration file"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1021" ;
    solveit-core:techniqueName "Extract artifacts from a configuration file" ;
    solveit-core:techniqueDescription "Examination of a file that was designed for storing configuration information for a piece of software (e.g. an application or operating system feature)" ;
    solveit-core:hasSynonym "configuration file examination" ;
    solveit-core:hasExample "prefs.js from Firefox" ;
    solveit-core:hasCASEInputClass solveit-observable:FileSet,
                                   uco-observable:File ;
    solveit-core:hasCASEOutputClass <https://ontology.unifiedcyberontology.org/uco/configuration/Configuration>,
                                    <https://ontology.unifiedcyberontology.org/uco/configuration/ConfigurationEntry> .

:techniqueDFT-1022
    a owl:Class,
      solveit-core:Technique ;
    rdfs:label "DFT-1022: Capture mobile device screenshots (manually)"@en ;
    rdfs:subClassOf solveit-core:SolveitInvestigativeAction ;
    solveit-core:techniqueID "DFT-1022" ;
    solveit-core:techniqueName "Capture mobile device screenshots (manually)" ;
    solveit-core:techniqueDescription "An examiner directly manipulates the target mobile device using the device's input interface (i.e., keypads and buttons), and records the content shown on the display of the device. (Fukami et al 2021)" ;
    solveit-core:techniqueDetails "This is the manual version of DFT-1163. The device is controlled manually, and screenshots are captured manually." ;
    solveit-core:hasCASEInputClass uco-observable:MobileDevice ;
    solveit-core:hasCASEOutputClass solveit-observable:DeviceScreenshotCapture ;
    solveit-core:hasReference :citationDFCite-1045 .

