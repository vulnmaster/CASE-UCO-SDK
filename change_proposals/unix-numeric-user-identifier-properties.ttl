@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix uco-observable: <https://ontology.unifiedcyberontology.org/uco/observable/> .
@prefix proposed: <http://example.org/ontology/proposed/> .

# Prototype extension ontology for UCO change proposal:
# "UNIX numeric user identifier properties".
# Semantics grounded in POSIX getuid(2)/geteuid(2)
# (https://man7.org/linux/man-pages/man2/getuid.2.html,
# https://man7.org/linux/man-pages/man2/geteuid.2.html) and credentials(7)
# (https://man7.org/linux/man-pages/man7/credentials.7.html).

proposed:uid
    a owl:DatatypeProperty ;
    rdfs:domain uco-observable:UNIXAccountFacet ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "uid"@en ;
    rdfs:comment "The numeric user identifier (UID) of the UNIX account as recorded in the account database (e.g., /etc/passwd, Open Directory). Complements the existing gid property on UNIXAccountFacet."@en .

proposed:euid
    a owl:DatatypeProperty ;
    rdfs:domain uco-observable:UNIXProcessFacet ;
    rdfs:range xsd:nonNegativeInteger ;
    rdfs:label "euid"@en ;
    rdfs:comment "The effective user identifier (EUID) of the process, which governs access-control decisions; differs from the existing ruid property when setuid or credential-changing calls have occurred. See geteuid(2) and credentials(7)."@en .
