{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/forest-savage1234/CASE-UCO-SDK/topology/profiles/profile.schema.json",
  "title": "CASE/UCO Composition Profile",
  "description": "Versioned, offline-loadable composition profile. Profiles lower the cognitive load of correct CASE/UCO + CAC modeling without changing the ontology.",
  "type": "object",
  "required": [
    "id",
    "version",
    "title",
    "description",
    "required_modules",
    "recommended_modules",
    "facet_sets",
    "spine_anchors",
    "upper_ontology_profiles",
    "recipe_skeleton"
  ],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]+$" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "mission": { "type": "string" },
    "air_gapped": { "type": "boolean" },
    "required_modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_modules": {
      "type": "array",
      "items": { "type": "string" }
    },
    "facet_sets": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["required", "recommended"],
        "properties": {
          "required": { "type": "array", "items": { "type": "string" } },
          "recommended": { "type": "array", "items": { "type": "string" } },
          "notes": { "type": "string" }
        }
      }
    },
    "spine_anchors": {
      "type": "array",
      "items": { "type": "string" }
    },
    "upper_ontology_profiles": {
      "type": "array",
      "items": { "type": "string" }
    },
    "related_recipes": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recipe_skeleton": {
      "type": "object",
      "required": ["summary", "steps"],
      "properties": {
        "summary": { "type": "string" },
        "steps": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "contract": { "$ref": "#/$defs/contract" }
  },
  "$defs": {
    "repairHint": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "helper": { "type": ["string", "null"] },
        "builder_method": { "type": ["string", "null"] },
        "workflow_step": { "type": ["string", "null"] },
        "hint": { "type": "string" }
      }
    },
    "contractCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "severity", "blocking", "applies_to", "kind"],
      "properties": {
        "id": { "type": "string" },
        "when": { "enum": ["incremental", "step", "graph"] },
        "severity": { "enum": ["critical", "high", "medium", "low", "info"] },
        "blocking": { "type": "boolean" },
        "applies_to": { "type": "array", "items": { "type": "string" } },
        "kind": {
          "enum": [
            "required_facets",
            "recommended_facets",
            "hash_presence",
            "tool_version",
            "action_instrument",
            "spine_role_separation",
            "spine_kind_present",
            "trajectory_completeness",
            "hash_intelligence_mission",
            "cac_lifecycle_mission",
            "legal_process_mission",
            "airgap_partition",
            "shacl_signal",
            "concept_coverage_signal",
            "no_invented_photodna_facet",
            "cross_ontology_single_foundation"
          ]
        },
        "params": { "type": "object" },
        "repair": { "$ref": "#/$defs/repairHint" }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "checks"],
      "properties": {
        "schema_version": { "const": "1.0.0" },
        "default_validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "extensions": { "type": "array", "items": { "type": "string" } },
            "profiles": { "type": "array", "items": { "type": "string" } },
            "strict_concepts": { "type": "boolean" },
            "require_shacl": { "type": "boolean" }
          }
        },
        "partition_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": { "enum": ["forensic-boundary", "roots", "module-family", "none"] },
            "boundary": { "enum": ["volume", "device", "app", "session", "mailbox", "catalog-batch"] },
            "shared_node_policy": { "enum": ["replicate-identical", "isolate-shared"] },
            "max_estimated_triples": { "type": "integer", "minimum": 1 }
          }
        },
        "workflows": { "type": "array", "items": { "type": "string" } },
        "trajectories": { "type": "array", "items": { "type": "string" } },
        "adapters": { "type": "array", "items": { "type": "string" } },
        "checks": { "type": "array", "items": { "$ref": "#/$defs/contractCheck" } }
      }
    }
  }
}
